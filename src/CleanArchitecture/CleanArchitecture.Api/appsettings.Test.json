{
  "ConnectionStrings": {
    "ConnectionString": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://serilogseq:5341" }
      }
    ],
    "Enrich": ["FromLogContext","WithMachineName","WithThreadId"]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "c13b3952-79f6-4dce-859c-0468813773a9",
    "Issuer": "http://localhost:9000",
    "Audience": "http://localhost:9000"
  }
}
